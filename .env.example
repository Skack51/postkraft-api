# ─── Database ───────────────────────────────────────────────────────────────
# Railway provides this automatically when you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/postkraft

# ─── JWT ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ─── Stripe ─────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create a product + price at https://dashboard.stripe.com/products
STRIPE_PRICE_ID=price_...

# ─── Meta (Facebook / Instagram) OAuth ──────────────────────────────────────
# From https://developers.facebook.com/apps/ → your app → Settings → Basic
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=https://your-railway-domain.railway.app/oauth/meta/callback

# ─── LinkedIn OAuth ──────────────────────────────────────────────────────────
# From https://www.linkedin.com/developers/apps → your app → Auth
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://your-railway-domain.railway.app/oauth/linkedin/callback

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
# Your API key — users never see this
ANTHROPIC_API_KEY=sk-ant-...

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# The Electron app redirects here after OAuth completes
ELECTRON_DEEP_LINK_SCHEME=postkraft
